<Window x:Class="KeyBridge.FileTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyBridge Dosya Aktarımı"
        Width="1120" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F3F6F9">
    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="pack://application:,,,/KeyBridge;component/Assets/#Font Awesome 6 Free Solid"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Dosya Aktarım Merkezi" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="RemoteDeviceText" Foreground="#62748A" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#E7F8EF" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                <TextBlock Text="AES-GCM korumalı" Foreground="#087A44" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#D7E0E8" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Yerel bilgisayar" FontSize="15" FontWeight="SemiBold" Margin="4"/>
                    <Grid Grid.Row="1" Margin="0,5,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button ToolTip="Üst klasör" Click="UpButton_Click"><TextBlock Text="&#xF062;" Style="{StaticResource IconText}"/></Button>
                        <TextBox x:Name="LocalPathTextBox" Grid.Column="1" Margin="4" Padding="8,6" KeyDown="LocalPathTextBox_KeyDown"/>
                        <Button Grid.Column="2" Content="Yenile" Click="RefreshButton_Click"/>
                    </Grid>
                    <ListView x:Name="LocalFilesList" Grid.Row="2" MouseDoubleClick="LocalFilesList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Ad" Width="250" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Tür" Width="90" DisplayMemberBinding="{Binding Kind}"/>
                                <GridViewColumn Header="Boyut" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                                <GridViewColumn Header="Değiştirilme" Width="135" DisplayMemberBinding="{Binding ModifiedText}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button FontSize="22" ToolTip="Seçili dosyayı kuyruğa ekle" Click="QueueSelectedButton_Click"><TextBlock Text="&#xF061;" Style="{StaticResource IconText}"/></Button>
                <Button FontSize="22" ToolTip="Kuyruktan kaldır" Click="RemoveQueuedButton_Click"><TextBlock Text="&#xF060;" Style="{StaticResource IconText}"/></Button>
            </StackPanel>

            <Border Grid.Column="2" Background="White" BorderBrush="#D7E0E8" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Uzak bilgisayar / aktarım kuyruğu" FontSize="15" FontWeight="SemiBold" Margin="4"/>
                    <Border Grid.Row="1" Background="#F5F8FA" CornerRadius="5" Padding="10" Margin="0,5,0,8">
                        <TextBlock Text="Hedef: İndirilenler\KeyBridge Transfers" Foreground="#536579"/>
                    </Border>
                    <ListView x:Name="TransferQueueList" Grid.Row="2">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Dosya" Width="250" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Boyut" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                                <GridViewColumn Header="Durum" Width="130" DisplayMemberBinding="{Binding Status}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#101D2D" CornerRadius="8" Margin="0,12,0,8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Aktarım günlüğü" Foreground="White" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="TransferProgress" Width="180" Height="8" HorizontalAlignment="Right" IsIndeterminate="True" Visibility="Collapsed"/>
                </Grid>
                <ListBox x:Name="TransferLogList" Grid.Row="1" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" Foreground="#C8D5E3"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal">
                <Button Content="Dosya Seç..." Click="ChooseFilesButton_Click"/>
                <Button Content="Kuyruğu Temizle" Click="ClearQueueButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Kapat" Click="CloseButton_Click"/>
                <Button x:Name="SendQueueButton" Content="Kuyruğu Gönder" Background="#087DD1" Foreground="White" FontWeight="SemiBold" Click="SendQueueButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
