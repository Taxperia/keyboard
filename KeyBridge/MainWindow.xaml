<Window x:Class="KeyBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d" Title="KeyBridge"
        Width="1480" Height="800" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="CanResize" AllowsTransparency="False" Background="#F6F9FC"
        Icon="Assets/KeyBridge.ico"
        FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#101828"/>
        <SolidColorBrush x:Key="Muted" Color="#64748B"/>
        <SolidColorBrush x:Key="Blue" Color="#0A84FF"/>
        <SolidColorBrush x:Key="Line" Color="#D9E2EC"/>
        <SolidColorBrush x:Key="Green" Color="#12B76A"/>

        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="pack://application:,,,/KeyBridge;component/Assets/#Font Awesome 6 Free Solid"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EAF2F9"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="54"/><Setter Property="Margin" Value="10,2"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="NavChrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavChrome" Property="Background" Value="#E7F1F9"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActiveNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#DDEFFC"/><Setter Property="Foreground" Value="#064B7B"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="24"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.08" Color="#4F6B82"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#FA3E32"/><Setter Property="BorderBrush" Value="#FA3E32"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,0"/><Setter Property="Height" Value="54"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E83228"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CED8E3"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#F1F6FA"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#F2F5F8"/><Setter Property="BorderBrush" Value="#E4EAF0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="15"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="22"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Track" Background="#CBD5E1" CornerRadius="11"><Border x:Name="Thumb" Width="16" Height="16" Margin="3" HorizontalAlignment="Left" Background="White" CornerRadius="8"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#0A84FF"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#F6F9FC" BorderBrush="#C8D4DF" BorderThickness="1" CornerRadius="13"><Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity=".25" Color="#314A60"/></Border.Effect></Border>
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Background="#F8FAFC" BorderBrush="#DEE6EE" BorderThickness="0,0,1,0" CornerRadius="13,0,0,13">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/><RowDefinition Height="178"/><RowDefinition Height="92"/></Grid.RowDefinitions>
                    <Grid Margin="28,0,18,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="38" Height="38" VerticalAlignment="Center">
                            <Border Width="31" Height="13" CornerRadius="7" Background="#0E7490" RenderTransformOrigin=".5,.5"><Border.RenderTransform><RotateTransform Angle="-35"/></Border.RenderTransform></Border>
                            <Border Width="31" Height="13" CornerRadius="7" Background="#12B8B0" Margin="8,-8,0,0" RenderTransformOrigin=".5,.5"><Border.RenderTransform><RotateTransform Angle="-35"/></Border.RenderTransform></Border>
                            <Ellipse Width="10" Height="10" Fill="#F8FAFC"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="KeyBridge" FontSize="25" FontWeight="Bold" Foreground="#0B1220"/><TextBlock Text="Her yerde, yanınızda." FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Button x:Name="HomeSidebarButton" AutomationProperties.Name="Ana Sayfa" Style="{StaticResource ActiveNavButton}" Click="HomeNavButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF015;" Style="{StaticResource IconText}" Foreground="#075985"/><TextBlock Text="Ana Sayfa" Margin="22,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="DevicesSidebarButton" AutomationProperties.Name="Cihazlar" Style="{StaticResource NavButton}" Click="DevicesNavButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF109;" Style="{StaticResource IconText}"/><TextBlock Text="Cihazlar" Margin="22,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="ConnectionsSidebarButton" AutomationProperties.Name="Bağlantılar" Style="{StaticResource NavButton}" Click="ConnectionsNavButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF0C1;" Style="{StaticResource IconText}"/><TextBlock Text="Bağlantılar" Margin="22,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="HistorySidebarButton" AutomationProperties.Name="Geçmiş" Style="{StaticResource NavButton}" Click="HistoryNavButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF017;" Style="{StaticResource IconText}"/><TextBlock Text="Geçmiş" Margin="22,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="SettingsSidebarButton" AutomationProperties.Name="Ayarlar" Style="{StaticResource NavButton}" Click="SettingsNavButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF013;" Style="{StaticResource IconText}"/><TextBlock Text="Ayarlar" Margin="22,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                    </StackPanel>
                    <Border Grid.Row="2" Margin="18,10" Padding="18" Background="#E8F1F8" CornerRadius="9">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xF024;" Style="{StaticResource IconText}" Foreground="#F4A300"/><TextBlock Text="Tam Sürüm" Margin="12,0,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/></StackPanel>
                            <TextBlock Grid.Row="1" Text="Tüm özellikler bu sürümde etkin." Margin="34,10,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <Button Grid.Row="2" Content="Özellikleri Gör" Style="{StaticResource OutlineButton}" Foreground="#075985" Click="UpgradeButton_Click"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="26,4,16,0"><StackPanel Orientation="Horizontal"><Ellipse Width="11" Height="11" Fill="{StaticResource Green}" VerticalAlignment="Center"/><TextBlock x:Name="SidebarStatusText" Text="Tüm sistemler çalışıyor" Margin="11,0,0,0" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Text="KeyBridge v0.2.5" FontSize="11" Foreground="#8795A6" Margin="0,18,0,0"/></StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#F8FAFC" BorderBrush="#E4EAF0" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="20,0,12,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                        <Grid Height="42" MaxWidth="650" HorizontalAlignment="Stretch" Margin="0,0,14,0"><TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" GotKeyboardFocus="SearchBox_GotKeyboardFocus" LostKeyboardFocus="SearchBox_LostKeyboardFocus" Padding="36,0,68,0" Background="White" BorderBrush="#DCE4EC"/><TextBlock Text="&#xF002;" Style="{StaticResource IconText}" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/><TextBlock x:Name="SearchPlaceholder" Text="Cihaz adı veya IP adresi ara..." Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False"/><Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Padding="7,3" Background="#F8FAFC" BorderBrush="#D8E1EA" BorderThickness="1" CornerRadius="5" IsHitTestVisible="False"><TextBlock Text="Ctrl + K" FontSize="11" Foreground="#64748B"/></Border></Grid>
                        <Grid Grid.Column="1" HorizontalAlignment="Right"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="1"/><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="NotificationButton" Style="{StaticResource IconButton}" ToolTip="Bildirimler" Click="NotificationButton_Click"><Grid><TextBlock Text="&#xF0F3;" Style="{StaticResource IconText}"/><Ellipse x:Name="NotificationDot" Width="6" Height="6" Fill="#0A84FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"/></Grid></Button><Border Grid.Column="1" Width="1" Height="38" Background="#E5EBF1"/><Border Grid.Column="2" Width="39" Height="39" CornerRadius="20" Background="#2663D8" HorizontalAlignment="Center"><TextBlock Text="KB" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="Merhaba," FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="HeaderDeviceNameText" Text="Bu Bilgisayar" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/></StackPanel></Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource IconButton}" Click="MinimizeWindowButton_Click"><TextBlock Text="&#xF068;" Style="{StaticResource IconText}" FontSize="14"/></Button><Button x:Name="MaximizeWindowButton" Style="{StaticResource IconButton}" Click="MaximizeWindowButton_Click"><TextBlock Text="&#xF065;" Style="{StaticResource IconText}" FontSize="13"/></Button><Button Style="{StaticResource IconButton}" Click="CloseWindowButton_Click"><TextBlock Text="&#xF00D;" Style="{StaticResource IconText}" FontSize="16"/></Button></StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="18,16,18,14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center"><Grid Height="690" MaxWidth="1480">
                    <Grid.RowDefinitions><RowDefinition Height="2.05*"/><RowDefinition Height="2.05*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.03*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,7">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xF109;" Style="{StaticResource IconText}" FontSize="37" Foreground="#064F7D"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Bu Bilgisayar" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Ink}"/><TextBlock Text="Bu cihazı başkalarının bağlantı kurması için paylaşın." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="2" Background="#E6F8EF" CornerRadius="16" Padding="13,7" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource Green}"/><TextBlock Text="Çevrimiçi" Margin="8,0,5,0" Foreground="#087A44" FontSize="12"/><TextBlock Text="&#xF107;" Style="{StaticResource IconText}" FontSize="11" Foreground="#087A44"/></StackPanel></Border></Grid>
                            <Grid Grid.Row="1" Margin="0,8,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="1*"/><RowDefinition Height="1.22*"/><RowDefinition Height="1*"/></Grid.RowDefinitions>
                                <TextBlock Text="Cihaz Adı" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Grid.Column="1" Background="#F1F4F7" CornerRadius="7" Margin="0,3"><TextBlock x:Name="LocalDeviceNameText" FontSize="14" VerticalAlignment="Center" Margin="16,0"/></Border><Button Grid.Column="2" Style="{StaticResource IconButton}" Click="CopyDeviceNameButton_Click" ToolTip="Cihaz adını kopyala"><TextBlock Text="&#xF0C5;" Style="{StaticResource IconText}" FontSize="17"/></Button>
                                <TextBlock Grid.Row="1" Text="Bağlantı Kodu" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Grid.Row="1" Grid.Column="1" Background="#F1F4F7" CornerRadius="7" Margin="0,3"><TextBlock x:Name="PairingCodeText" Text="--- ---" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0"/></Border><Button Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButton}" Click="CopyPairingCodeButton_Click" ToolTip="Bağlantı kodunu kopyala"><TextBlock Text="&#xF0C5;" Style="{StaticResource IconText}" FontSize="17"/></Button>
                                <TextBlock Grid.Row="2" Text="Erişim Şifresi" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Grid.Row="2" Grid.Column="1" Background="#F1F4F7" CornerRadius="7" Margin="0,3" Cursor="Hand" MouseLeftButtonDown="AccessPassword_MouseLeftButtonDown"><Grid><TextBlock x:Name="AccessPasswordText" Text="••••••" FontSize="20" VerticalAlignment="Center" Margin="16,0"/><TextBlock Text="&#xF06E;" Style="{StaticResource IconText}" FontSize="16" HorizontalAlignment="Right" Margin="0,0,14,0" Foreground="#667085"/></Grid></Border><Button Grid.Row="2" Grid.Column="2" Style="{StaticResource IconButton}" Click="GenerateCodeButton_Click" ToolTip="Yeni kod üret"><TextBlock Text="&#xF2F1;" Style="{StaticResource IconText}" FontSize="17"/></Button>
                            </Grid>
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><Border Background="#F0F6FB" CornerRadius="7" Padding="14,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF3ED;" Style="{StaticResource IconText}" Foreground="#63A7E8" FontSize="18"/><TextBlock Text="Bu bilgilerle diğer kişiler bu cihazınıza bağlanabilir." FontSize="11" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Border><Button Grid.Column="1" Content="Paylaş" Margin="10,0,0,0" Style="{StaticResource OutlineButton}" Click="ShareButton_Click"/></Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,7">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xF1D8;" Style="{StaticResource IconText}" Foreground="#00558C" FontSize="38" Width="50"/><StackPanel Margin="8,0,0,0"><TextBlock Text="Uzak Bilgisayara Bağlan" FontSize="21" FontWeight="Bold"/><TextBlock Text="Uzaktaki bir cihaza bağlanın ve kontrol sağlayın." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></StackPanel>
                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="PairingCodeInput" MaxLength="11" Background="White" BorderBrush="#A7B9CD" FontSize="15" TextChanged="PairingCodeInput_TextChanged" GotKeyboardFocus="PairingCodeInput_GotKeyboardFocus" LostKeyboardFocus="PairingCodeInput_LostKeyboardFocus"/><TextBlock x:Name="CodePlaceholder" Text="Bağlantı kodunu girin (örn. 123 456)" Foreground="#7B8AA0" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid><Button Grid.Column="1" Margin="10,0,0,0" Content="Bağlan   ›" Style="{StaticResource PrimaryButton}" Click="ConnectButton_Click"/></Grid>
                            <UniformGrid Grid.Row="2" Columns="3" Margin="0,14,0,8"><Button x:Name="ViewModeButton" ToolTip="Yalnızca uzak ekranı izle" Padding="5,6" Style="{StaticResource OutlineButton}" Margin="0,0,5,0" Click="ViewModeButton_Click"><StackPanel><TextBlock Text="&#xF06E;" Style="{StaticResource IconText}" FontSize="24"/><TextBlock Text="Ekranı İzle" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="Yalnızca görüntü" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button><Button x:Name="ControlModeButton" ToolTip="Uzak klavye ve fareyi kontrol et" Padding="5,6" Style="{StaticResource OutlineButton}" BorderBrush="#49AFFF" Background="#EAF6FF" Margin="5,0" Click="ControlModeButton_Click"><StackPanel><TextBlock Text="&#xF8CC;" Style="{StaticResource IconText}" Foreground="#075EA8" FontSize="24"/><TextBlock Text="Tam Kontrol" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="Klavye + fare" FontSize="10" Foreground="#3174AA" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button><Button x:Name="FileModeButton" ToolTip="Dosya gönder ve al" Padding="5,6" Style="{StaticResource OutlineButton}" Margin="5,0,0,0" Click="FileModeButton_Click"><StackPanel><TextBlock Text="&#xF574;" Style="{StaticResource IconText}" FontSize="24"/><TextBlock Text="Dosyalar" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="Gönder / al" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button></UniformGrid>
                            <Grid Grid.Row="3"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF017;" Style="{StaticResource IconText}" FontSize="15" Foreground="#64748B"/><TextBlock Text="Hızlı bağlantı için cihazlarınızı kaydedin." FontSize="11" Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel><Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#087DD1" Cursor="Hand" Click="SettingsNavButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF013;" Style="{StaticResource IconText}" FontSize="15" Foreground="#087DD1"/><TextBlock Text="Gelişmiş Seçenekler⌄" FontSize="11" Margin="8,0,0,0"/></StackPanel></Button></Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,7,7,7" Padding="18,12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF017;" Style="{StaticResource IconText}" FontSize="27"/><StackPanel Margin="14,0,0,0"><TextBlock Text="Son Cihazlar" FontSize="17" FontWeight="Bold"/><TextBlock Text="En son bağlandığınız cihazlar." FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel><Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#087DD1" Content="Tümünü Gör" Cursor="Hand" Click="DevicesNavButton_Click"/></Grid>
                            <Grid Grid.Row="1"><ListBox x:Name="DeviceList" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E5EBF1" BorderThickness="0,1,0,0" Height="54"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="94"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><Border Width="54" Height="38" BorderBrush="#CCD7E2" BorderThickness="1" CornerRadius="5" Background="#EEF5FA"><TextBlock Text="&#xF109;" Style="{StaticResource IconText}" FontSize="26" Foreground="#075EA8"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DeviceName}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Platform}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{Binding StatusBrush}"/><TextBlock Text="{Binding LastSeen}" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="3" Content="{Binding ConnectButtonText}" Style="{StaticResource OutlineButton}" Height="36" Padding="10,0" Tag="{Binding}" Click="RecentDeviceConnectButton_Click"/><Button Grid.Column="4" Style="{StaticResource IconButton}" ToolTip="Diğer seçenekler" Tag="{Binding}" Click="DeviceOptionsButton_Click"><TextBlock Text="&#xF142;" Style="{StaticResource IconText}" FontSize="20" Foreground="#45627A"/></Button></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="EmptyDevicesPanel" VerticalAlignment="Center"><TextBlock Text="&#xF109;" Style="{StaticResource IconText}" FontSize="30" Foreground="#9AABBA"/><TextBlock Text="Henüz bir cihaz bulunamadı" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#536579" Margin="0,8,0,0"/><TextBlock Text="Diğer bilgisayarda KeyBridge'i açın." HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="7,7,0,7" Padding="18,12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF109;" Style="{StaticResource IconText}" FontSize="25" Foreground="#0B4E79"/><TextBlock Text="Canlı Oturum" Margin="14,0,0,0" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel><Border HorizontalAlignment="Right" Background="#E6F8EF" CornerRadius="14" Padding="11,5" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Green}"/><TextBlock x:Name="SessionBadgeText" Text="Hazır" Foreground="#087A44" FontSize="10" Margin="7,0,0,0"/></StackPanel></Border></Grid>
                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width=".95*"/></Grid.ColumnDefinitions><Border Margin="0,0,18,8" CornerRadius="5" Background="#09273C" BorderBrush="#0B1C2B" BorderThickness="7"><Grid ClipToBounds="True"><Grid.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#071A2A" Offset="0"/><GradientStop Color="#0D6E9B" Offset=".48"/><GradientStop Color="#38A8E2" Offset="1"/></LinearGradientBrush></Grid.Background><Ellipse Width="210" Height="110" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-38,0" Stroke="#46A4FF" StrokeThickness="22" RenderTransformOrigin=".5,.5"><Ellipse.RenderTransform><RotateTransform Angle="-24"/></Ellipse.RenderTransform></Ellipse><Ellipse Width="160" Height="80" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0" Stroke="#1C63F5" StrokeThickness="18" RenderTransformOrigin=".5,.5"><Ellipse.RenderTransform><RotateTransform Angle="-24"/></Ellipse.RenderTransform></Ellipse><Border Height="16" VerticalAlignment="Bottom" Background="#09131D"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#4AA8FF" Margin="2"/><Rectangle Width="7" Height="7" Fill="#F5F7FA" Margin="2"/><Ellipse Width="6" Height="6" Fill="#F7C548" Margin="2"/></StackPanel></Border><Image x:Name="RemoteScreenImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/><Button Panel.ZIndex="2" Style="{StaticResource IconButton}" Background="#55000000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" ToolTip="Tam ekran görüntüle" Click="OpenFullScreenPreviewButton_Click"><TextBlock Text="&#xF065;" Style="{StaticResource IconText}" Foreground="White"/></Button></Grid></Border>
                                <StackPanel Grid.Column="1"><TextBlock Text="Bağlı cihaz" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SessionDeviceNameText" Text="Cihaz bağlı değil" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,14" TextTrimming="CharacterEllipsis"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Oturum süresi" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SessionDurationText" Text="00:00:00" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Gecikme" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SessionLatencyText" Text="-- ms" FontSize="12" Foreground="#079455" Margin="0,5,0,0"/></StackPanel></Grid><TextBlock Text="Bağlantı kalitesi" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,17,0,0"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="&#xF012;" Style="{StaticResource IconText}" Foreground="{StaticResource Green}" FontSize="17"/><TextBlock x:Name="ConnectionQualityText" Text="Bekleniyor" Foreground="#079455" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Background="#E7FAEF" CornerRadius="7" Padding="14,0"><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="&#xF8CC;" Style="{StaticResource IconText}" Foreground="#079455"/><StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="ControlStatusText" Text="Bağlantı bekleniyor" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="ControlStatusSubText" Text="Bir cihaz bağlandığında burada görünecek." FontSize="9" Foreground="#128250"/></StackPanel></StackPanel><Button x:Name="DisconnectDeviceButton" HorizontalAlignment="Right" Content="Bağlantıyı Kes" Style="{StaticResource OutlineButton}" Foreground="#B42318" BorderBrush="#F97066" Visibility="Collapsed" Click="DisconnectDeviceButton_Click"/></Grid></Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="White" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="10" Margin="0,5,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="18,0"><Border Width="39" Height="39" Background="#E8F4FC" CornerRadius="20"><TextBlock Text="&#xF3ED;" Style="{StaticResource IconText}" Foreground="#075EA8"/></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Güvenlik ve İzinler" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Bağlanan kullanıcılar için izinleri yönetin." FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
                            <Border Grid.Column="1" Margin="12,0" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0"><Grid><TextBlock Text="&#xF11C;" Style="{StaticResource IconText}" HorizontalAlignment="Left" Margin="16,0,0,0"/><StackPanel Margin="50,0" VerticalAlignment="Center"><TextBlock Text="Klavye kontrolü" FontSize="12"/><TextBlock Text="İzin ver" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel><CheckBox x:Name="KeyboardControlCheckBox" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Checked="InputControlCheckBox_Changed" Unchecked="InputControlCheckBox_Changed"/></Grid></Border>
                            <Border Grid.Column="2" Margin="12,0" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0"><Grid><TextBlock Text="&#xF8CC;" Style="{StaticResource IconText}" HorizontalAlignment="Left" Margin="16,0,0,0"/><StackPanel Margin="50,0" VerticalAlignment="Center"><TextBlock Text="Fare kontrolü" FontSize="12"/><TextBlock Text="İzin ver" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel><CheckBox x:Name="MouseControlCheckBox" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Checked="InputControlCheckBox_Changed" Unchecked="InputControlCheckBox_Changed"/></Grid></Border>
                            <Border Grid.Column="3" Margin="12,0" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0"><Grid><TextBlock Text="&#xF0C5;" Style="{StaticResource IconText}" HorizontalAlignment="Left" Margin="16,0,0,0"/><StackPanel Margin="50,0" VerticalAlignment="Center"><TextBlock Text="Panoya erişim" FontSize="12"/><TextBlock Text="Metni eşitle" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel><CheckBox x:Name="ClipboardAccessCheckBox" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" Checked="ClipboardAccessCheckBox_Changed" Unchecked="ClipboardAccessCheckBox_Changed"/></Grid></Border>
                            <Border Grid.Column="4" Margin="12,0" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0"><Grid><TextBlock Text="&#xF023;" Style="{StaticResource IconText}" HorizontalAlignment="Left" Margin="16,0,0,0"/><StackPanel Margin="50,0" VerticalAlignment="Center"><TextBlock Text="Güvenli bağlantı" FontSize="12"/><TextBlock Text="AES-GCM etkin" FontSize="9" Foreground="{StaticResource Muted}"/></StackPanel><CheckBox IsChecked="True" IsEnabled="False" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/></Grid></Border>
                        </Grid>
                    </Border>

                    <Grid x:Name="SectionPage" Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="20" Visibility="Collapsed" Background="#F6F9FC">
                        <Border Style="{StaticResource Card}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel><TextBlock x:Name="SectionTitleText" Text="Cihazlar" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="SectionSubtitleText" Text="Yerel ağdaki cihazlar" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
                                    <Button HorizontalAlignment="Right" Content="Ana Sayfaya Dön" Style="{StaticResource OutlineButton}" Click="CloseSectionButton_Click"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SectionContentPanel" Margin="0,8,0,0"/></ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Popup x:Name="NotificationPopup" PlacementTarget="{Binding ElementName=NotificationButton}" Placement="Bottom" HorizontalOffset="-306" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="360" MaxHeight="430" Background="White" BorderBrush="#D4DEE8" BorderThickness="1" CornerRadius="8" Padding="0">
                <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity=".22" Color="#26384A"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="Auto"/><RowDefinition Height="48"/></Grid.RowDefinitions>
                    <Grid Margin="18,0">
                        <TextBlock Text="Bildirimler" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Content="Temizle" Background="Transparent" BorderThickness="0" Foreground="#087DD1" Cursor="Hand" Click="ClearNotificationsButton_Click"/>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="#E5EBF1" BorderThickness="0,1,0,1">
                        <ScrollViewer MaxHeight="310" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <TextBlock x:Name="NotificationEmptyText" Text="Henüz bildirim yok." Margin="18,24" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                <StackPanel x:Name="NotificationItemsPanel"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    <Button Grid.Row="2" Content="Tüm bildirimleri gör" Background="Transparent" BorderThickness="0" Foreground="#087DD1" FontWeight="SemiBold" Cursor="Hand" Click="OpenNotificationHistoryButton_Click"/>
                </Grid>
            </Border>
        </Popup>

        <Grid x:Name="SettingsModal" Panel.ZIndex="50" Visibility="Collapsed" Background="#660B1726" MouseLeftButtonDown="SettingsModal_MouseLeftButtonDown">
            <Border Width="640" Height="640" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" BorderBrush="#D6E0E9" BorderThickness="1" CornerRadius="10" Padding="24" MouseLeftButtonDown="SettingsCard_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock Text="Ayarlar" FontSize="21" FontWeight="Bold"/><TextBlock Text="Cihaz, izin ve bağlantı tercihlerini yönetin." FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel><Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="CloseSettingsButton_Click"><TextBlock Text="&#xF00D;" Style="{StaticResource IconText}"/></Button></Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,10,8,8">
                        <Border Background="#F5F8FA" CornerRadius="8" Padding="16" Margin="0,0,0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Cihaz adı" FontWeight="SemiBold"/><TextBlock Text="Ağdaki diğer cihazlarda görünen ad." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><TextBox x:Name="SettingsDeviceNameTextBox" Grid.Column="1" Height="36"/><Button Grid.Column="2" Content="Kaydet" Height="36" Margin="8,0,0,0" Style="{StaticResource OutlineButton}" Click="SaveDeviceNameButton_Click"/></Grid></Border>
                        <Border Background="#F5F8FA" CornerRadius="8" Padding="16" Margin="0,0,0,9"><Grid><StackPanel><TextBlock Text="Windows ile başlat" FontWeight="SemiBold"/><TextBlock Text="Bilgisayar açıldığında KeyBridge hazır olsun." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="AutoStartCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" Checked="AutoStartCheckBox_Changed" Unchecked="AutoStartCheckBox_Changed"/></Grid></Border>
                        <Border Background="#F5F8FA" CornerRadius="8" Padding="16" Margin="0,0,0,9"><Grid><StackPanel><TextBlock Text="Klavye kontrolü" FontWeight="SemiBold"/><TextBlock Text="Eşleşmiş cihazdan klavye girdisini kabul et." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="SettingsKeyboardControlCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" Checked="SettingsInputCheckBox_Changed" Unchecked="SettingsInputCheckBox_Changed"/></Grid></Border>
                        <Border Background="#F5F8FA" CornerRadius="8" Padding="16" Margin="0,0,0,9"><Grid><StackPanel><TextBlock Text="Fare kontrolü" FontWeight="SemiBold"/><TextBlock Text="Eşleşmiş cihazdan fare girdisini kabul et." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="SettingsMouseControlCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" Checked="SettingsInputCheckBox_Changed" Unchecked="SettingsInputCheckBox_Changed"/></Grid></Border>
                        <Border Background="#F5F8FA" CornerRadius="8" Padding="16" Margin="0,0,0,9"><Grid><StackPanel><TextBlock Text="Metin panosunu eşitle" FontWeight="SemiBold"/><TextBlock Text="Açıldığında kopyalanan metin eşleşmiş cihaza şifreli gönderilir." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="SettingsClipboardAccessCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" Checked="SettingsClipboardCheckBox_Changed" Unchecked="SettingsClipboardCheckBox_Changed"/></Grid></Border>
                        <Border Background="#F5F8FA" CornerRadius="8" Padding="16" Margin="0,0,0,9"><Grid><StackPanel><TextBlock Text="Alınan dosyalar" FontWeight="SemiBold"/><TextBlock Text="İndirilenler\KeyBridge Transfers" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><Button HorizontalAlignment="Right" Content="Klasörü Aç" Style="{StaticResource OutlineButton}" Click="OpenTransfersFolderButton_Click"/></Grid></Border>
                        <Border Background="#F5F8FA" CornerRadius="8" Padding="16" Margin="0,0,0,9"><StackPanel><TextBlock Text="Kontrol kısayolu" FontWeight="SemiBold"/><TextBlock Text="Bilgisayarlar arasında geçiş: Ctrl + Alt + K" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Background="#FFF8E7" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="Yerel ağ bağlantısı" FontWeight="SemiBold" Foreground="#9A6700"/><TextBlock Text="Oturum trafiği AES-GCM ile korunur. Otomatik keşif yalnızca aynı yerel ağda çalışır; farklı ağlardan bağlantı bu sürümde desteklenmez." FontSize="11" Foreground="#795700" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                    <Button Grid.Row="2" HorizontalAlignment="Right" Width="96" Height="38" Content="Tamam" Style="{StaticResource PrimaryButton}" Click="CloseSettingsButton_Click"/>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="FirstRunModal" Panel.ZIndex="70" Visibility="Collapsed" Background="#E60B1726">
            <Border Width="650" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" BorderBrush="#D6E0E9" BorderThickness="1" CornerRadius="12" Padding="34">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="KeyBridge'i Hazırlayalım" FontSize="28" FontWeight="Bold"/><TextBlock Text="Bu ayarları daha sonra Ayarlar bölümünden değiştirebilirsiniz." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Bu bilgisayarın adı" FontWeight="SemiBold"/><TextBox x:Name="OnboardingDeviceNameTextBox" Height="44" Margin="0,8,0,18"/>
                        <Border Background="#F5F8FA" CornerRadius="8" Padding="16" Margin="0,0,0,10"><Grid><StackPanel><TextBlock Text="Klavye kontrolüne izin ver" FontWeight="SemiBold"/><TextBlock Text="Eşleşmiş bilgisayar klavyeyi kontrol edebilir." FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel><CheckBox x:Name="OnboardingKeyboardCheckBox" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"/></Grid></Border>
                        <Border Background="#F5F8FA" CornerRadius="8" Padding="16" Margin="0,0,0,10"><Grid><StackPanel><TextBlock Text="Fare kontrolüne izin ver" FontWeight="SemiBold"/><TextBlock Text="Eşleşmiş bilgisayar fareyi kontrol edebilir." FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel><CheckBox x:Name="OnboardingMouseCheckBox" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"/></Grid></Border>
                        <Border Background="#F5F8FA" CornerRadius="8" Padding="16"><Grid><StackPanel><TextBlock Text="Metin panosunu eşitle" FontWeight="SemiBold"/><TextBlock Text="Gizlilik için varsayılan olarak kapalıdır." FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel><CheckBox x:Name="OnboardingClipboardCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}"/></Grid></Border>
                        <TextBlock Text="Otomatik cihaz keşfi yalnızca aynı yerel ağda çalışır. Oturum verileri eşleşmeden sonra AES-GCM ile korunur." FontSize="11" Foreground="#795700" Margin="0,18,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Row="2" Content="Kurulumu Tamamla" HorizontalAlignment="Right" Width="190" Style="{StaticResource PrimaryButton}" Click="CompleteOnboardingButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
